# Loopback is the safe default. Public binding additionally requires
# REHEARSAL_ALLOW_PUBLIC_BIND=true.
REHEARSAL_BIND_HOST=127.0.0.1
REHEARSAL_ALLOW_PUBLIC_BIND=false
REHEARSAL_PORT=18081

# Replace X/Y/Z/N with an approved exact custom build; never use latest.
SUB2API_IMAGE=ghcr.io/o87110/sub2api-custom-public:vX.Y.Z-custom.N

POSTGRES_USER=sub2api_rehearsal
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=sub2api_rehearsal

REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

ADMIN_EMAIL=rehearsal-admin@example.invalid
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
JWT_SECRET=CHANGE_ME_JWT_SECRET
TOTP_ENCRYPTION_KEY=CHANGE_ME_TOTP_ENCRYPTION_KEY

UPDATE_PROXY_URL=

TZ=Asia/Shanghai
